# Copy to .env. Supply your own secrets. Never commit .env.
AI_API_KEY=
# Leave these blank to use config.json (including the GUI configuration).
AI_BASE_URL=
AI_MODEL=

# Optional provider-specific fallback keys. Keep unused entries empty.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
VISION_API_KEY=
VOICE_API_KEY=
ASR_API_KEY=

# Match your separately installed OneBot v11 gateway.
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=

# Optional separate QQ space gateway; see docs/QZONE.md.
QZONE_HTTP_URL=
QZONE_ACCESS_TOKEN=
# Optional authorized local protocol adapter; never commit the implementation.
QZONE_PROTOCOL_MODULE=
QZONE_SOURCE_DIR=
COMPANION_ENABLE_NATIVE_TOOLS=
COMPANION_GATEWAY_DIR=

# Optional DSH bridge credentials; unused in the companion path.
DSH_AUTH_TOKEN=
BRIDGE_CONSOLE_TOKEN=

# Executables installed by the deployer; quote paths containing spaces.
FFMPEG_PATH=ffmpeg
PHONE_ADB=adb
PHONE_FFMPEG=ffmpeg
PHONE_SERIAL=
