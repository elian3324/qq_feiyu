{
  "name": "ai-companion-kit",
  "version": "1.0.0",
  "private": true,
  "description": "给 AI 一副身体，和一点人味 —— 会记事的陪聊 + 能控制安卓手机的 MCP",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "demo": "node --env-file=../.env packages/companion/examples/demo.js",
    "check": "node --env-file=../.env scripts/check.mjs",
    "phone": "node --env-file=../.env packages/phone-mcp/src/phone-mcp.js",
    "phone:test": "node --env-file=../.env packages/phone-mcp/src/phone-mcp.js --selftest",
    "qzone": "node --env-file=../.env packages/qzone/open-zone.mjs",
    "qzone:test": "node --env-file=../.env packages/qzone-mcp/src/qzone-mcp.js --selftest",
    "qzone:mcp": "node --env-file=../.env packages/qzone-mcp/src/qzone-mcp.js"
  },
  "keywords": [
    "ai",
    "companion",
    "chatbot",
    "mcp",
    "model-context-protocol",
    "android",
    "adb",
    "automation",
    "onebot",
    "qq",
    "memory",
    "persona"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
